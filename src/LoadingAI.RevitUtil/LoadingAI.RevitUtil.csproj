    <RootNamespace>LoadingAI.Tools</RootNamespace>
    <AssemblyName>LoadingAI.RevitUtil</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
