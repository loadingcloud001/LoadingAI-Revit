<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LoadingAI</RootNamespace>
    <AssemblyName>LoadingAI.Core</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- BoundedLog is internal on purpose: it is a logging detail, not API the
       shipped surface promises. The hosted test project asserts on it directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LoadingAI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <PackDefaultLlmKey Condition="'$(PackDefaultLlmKey)' == ''">false</PackDefaultLlmKey>
    <DefineConstants Condition="'$(PackDefaultLlmKey)' == 'true'">$(DefineConstants);LOADINGAI_PACKED_KEY</DefineConstants>
  </PropertyGroup>

  <!--
    The built-in provider normally calls the public gateway, which holds the upstream
    credential server-side, so nothing is compiled in. Packing a key is an explicit
    development-only opt-in (-p:PackDefaultLlmKey=true) for LOADINGAI_DIRECT_MINIMAX;
    without the LOADINGAI_PACKED_KEY define the generated bytes are compiled out.
  -->
  <Target Name="GenerateDefaultLlmKey" BeforeTargets="BeforeCompile"
          Condition="'$(PackDefaultLlmKey)' == 'true' And (Exists('$(MSBuildThisFileDirectory)..\..\local\default-llm.json') Or '$(LOADINGAI_DEFAULT_KEY)' != '')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\gen-default-llm-key.ps1&quot;" />
  </Target>

</Project>
