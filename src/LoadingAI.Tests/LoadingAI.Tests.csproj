<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LoadingAI\LoadingAI.csproj">
      <AdditionalProperties>SkipHostPluginBuild=true;SkipCopyAddin=true</AdditionalProperties>
    </ProjectReference>
    <!-- Tool factories (QueryTools/ViewTools/ParamTools/AllTools) live in the
         shipped core-tools plugin, so fake-bridge tests reference it directly. -->
    <ProjectReference Include="..\..\Plugins\core-tools\CoreToolsPlugin.csproj">
      <AdditionalProperties>SkipCopyAddin=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\Plugins\modeling-tools\ModelingToolsPlugin.csproj">
      <AdditionalProperties>SkipCopyAddin=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\Plugins\export-tools\ExportToolsPlugin.csproj">
      <AdditionalProperties>SkipCopyAddin=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\Plugins\view-tools\ViewToolsPlugin.csproj">
      <AdditionalProperties>SkipCopyAddin=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\Plugins\structure-cuts\StructureCutsPlugin.csproj">
      <AdditionalProperties>SkipCopyAddin=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\Plugins\qs-formwork\QsFormworkPlugin.csproj">
      <AdditionalProperties>SkipCopyAddin=true</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\Plugins\opening-tools\OpeningToolsPlugin.csproj">
      <AdditionalProperties>SkipCopyAddin=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>


