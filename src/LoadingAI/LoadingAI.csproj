<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LoadingAI</AssemblyName>
    <RootNamespace>LoadingAI</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoadingAI.Core\LoadingAI.Core.csproj" />
    <ProjectReference Include="..\LoadingAI.RevitUtil\LoadingAI.RevitUtil.csproj" />
  </ItemGroup>

  <!-- net48 (Revit 2024) backports: System.Range/Index + DPAPI are missing from .NET Framework -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" />
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitApiVersion)" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Post-build copy for addin: copy to %AppData%\Autodesk\Revit\Addins\$(RevitVersion)\LoadingAI\ -->
    <RevitAddinDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\LoadingAI\</RevitAddinDir>
  </PropertyGroup>

  <ItemGroup>
    <ShippedPlugin Include="$(MSBuildThisFileDirectory)..\..\Plugins\core-tools\CoreToolsPlugin.csproj">
      <Dll>$(AppData)\LoadingAI\Plugins\core-tools\LoadingAI.Plugins.CoreTools.dll</Dll>
    </ShippedPlugin>
    <ShippedPlugin Include="$(MSBuildThisFileDirectory)..\..\Plugins\export-tools\ExportToolsPlugin.csproj">
      <Dll>$(AppData)\LoadingAI\Plugins\export-tools\LoadingAI.Plugins.ExportTools.dll</Dll>
    </ShippedPlugin>
    <ShippedPlugin Include="$(MSBuildThisFileDirectory)..\..\Plugins\view-tools\ViewToolsPlugin.csproj">
      <Dll>$(AppData)\LoadingAI\Plugins\view-tools\LoadingAI.Plugins.ViewTools.dll</Dll>
    </ShippedPlugin>
    <ShippedPlugin Include="$(MSBuildThisFileDirectory)..\..\Plugins\modeling-tools\ModelingToolsPlugin.csproj">
      <Dll>$(AppData)\LoadingAI\Plugins\modeling-tools\LoadingAI.Plugins.ModelingTools.dll</Dll>
    </ShippedPlugin>
    <ShippedPlugin Include="$(MSBuildThisFileDirectory)..\..\Plugins\structure-cuts\StructureCutsPlugin.csproj">
      <Dll>$(AppData)\LoadingAI\Plugins\structure-cuts\LoadingAI.Plugins.StructureCuts.dll</Dll>
    </ShippedPlugin>
    <ShippedPlugin Include="$(MSBuildThisFileDirectory)..\..\Plugins\qs-formwork\QsFormworkPlugin.csproj">
      <Dll>$(AppData)\LoadingAI\Plugins\qs-formwork\LoadingAI.Plugins.QsFormwork.dll</Dll>
    </ShippedPlugin>
  </ItemGroup>

  <Target Name="BuildShippedPlugins" AfterTargets="Build" BeforeTargets="CopyAddin" Condition="'$(SkipHostPluginBuild)' != 'true'">
    <MSBuild Projects="@(ShippedPlugin)" Targets="Restore;Build" Properties="Configuration=$(Configuration);RevitVersion=$(RevitVersion);SkipHostPluginBuild=true" />
    <ItemGroup>
      <_MissingPlugin Include="@(ShippedPlugin)" Condition="!Exists('%(ShippedPlugin.Dll)')" />
    </ItemGroup>
    <Error Condition="'@(_MissingPlugin)' != ''" Text="Shipped plugin was not deployed: @(_MissingPlugin->'%(Dll)')" />
  </Target>

  <Target Name="CopyAddin" AfterTargets="Build" Condition="'$(SkipCopyAddin)' != 'true'">
    <MakeDir Directories="$(RevitAddinDir)" />
    <MakeDir Directories="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RevitAddinDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(RevitAddinDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).deps.json" DestinationFolder="$(RevitAddinDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\LoadingAI.addin" DestinationFolder="$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\" SkipUnchangedFiles="false" />
    <!-- copy all runtime deps (Toolkit etc) -->
    <ItemGroup>
      <_Deps Include="$(TargetDir)*.dll" Exclude="$(TargetDir)$(AssemblyName).dll;$(TargetDir)RevitAPI.dll;$(TargetDir)RevitAPIUI.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_Deps)" DestinationFolder="$(RevitAddinDir)" SkipUnchangedFiles="true" />
    <PropertyGroup>
      <_WebView2Loader Condition="Exists('$(TargetDir)runtimes\win-x64\native\WebView2Loader.dll')">$(TargetDir)runtimes\win-x64\native\WebView2Loader.dll</_WebView2Loader>
      <_WebView2Loader Condition="'$(_WebView2Loader)' == '' And Exists('$(TargetDir)WebView2Loader.dll')">$(TargetDir)WebView2Loader.dll</_WebView2Loader>
    </PropertyGroup>
    <Copy SourceFiles="$(_WebView2Loader)" DestinationFolder="$(RevitAddinDir)" SkipUnchangedFiles="true" Condition="'$(_WebView2Loader)' != ''" />
    <Message Text="Copied $(TargetPath) + deps + .addin to $(RevitAddinDir) and Addins\$(RevitVersion)\" Importance="high" />
  </Target>

  <!-- Per-user Always Load + Authenticode on the AppData DLL so Revit does not
       re-prompt after CopyAddin. Off in CI (SkipCopyAddin). Opt out locally
       with -p:SkipTrustAddin=true. Script never writes HKLM or a machine path. -->
  <Target Name="TrustAddin" AfterTargets="CopyAddin" Condition="'$(SkipCopyAddin)' != 'true' And '$(SkipTrustAddin)' != 'true'">
    <PropertyGroup>
      <_TrustScript>$(MSBuildThisFileDirectory)..\..\scripts\trust-addin.ps1</_TrustScript>
    </PropertyGroup>
    <!-- pwsh (7+): Windows PowerShell 5.1 often has no Cert: drive. CI never hits this. -->
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(_TrustScript)&quot; -RevitVersion $(RevitVersion) -DllPath &quot;$(RevitAddinDir)$(AssemblyName).dll&quot;" IgnoreExitCode="true" />
  </Target>

  <Target Name="CopyWeb" AfterTargets="CopyAddin" Condition="'$(SkipCopyAddin)' != 'true' And Exists('$(MSBuildProjectDirectory)\Web\dist\index.html')">
    <RemoveDir Directories="$(RevitAddinDir)Web\dist" Condition="Exists('$(RevitAddinDir)Web\dist')" />
    <ItemGroup>
      <_WebFiles Include="$(MSBuildProjectDirectory)\Web\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebFiles)" DestinationFiles="@(_WebFiles->'$(RevitAddinDir)Web\dist\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Text="Copied Web/dist to $(RevitAddinDir)Web\dist\" Importance="high" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Ribbon32.png" LogicalName="LoadingAI.Resources.Ribbon32.png" />
    <EmbeddedResource Include="Resources\Ribbon16.png" LogicalName="LoadingAI.Resources.Ribbon16.png" />
  </ItemGroup>

</Project>
