<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LoadingAI.Plugins.OpeningTools</AssemblyName>
    <RootNamespace>LoadingAI.Plugins.OpeningTools</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PluginOutDir>$(AppData)\LoadingAI\Plugins\opening-tools\</PluginOutDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LoadingAI_Opening_Horizontal.rfa" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LoadingAI_Opening_Vertical.rfa" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LoadingAI.Core\LoadingAI.Core.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\src\LoadingAI.RevitUtil\LoadingAI.RevitUtil.csproj">
      <Private>false</Private>
    </ProjectReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="CopyPlugin" AfterTargets="Build" Condition="'$(SkipCopyAddin)' != 'true'">
    <MakeDir Directories="$(PluginOutDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginOutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)plugin.json" DestinationFolder="$(PluginOutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)LoadingAI_Opening_Horizontal.rfa" DestinationFolder="$(PluginOutDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)LoadingAI_Opening_Horizontal.rfa')" />
    <Copy SourceFiles="$(ProjectDir)LoadingAI_Opening_Vertical.rfa" DestinationFolder="$(PluginOutDir)" SkipUnchangedFiles="true" Condition="Exists('$(ProjectDir)LoadingAI_Opening_Vertical.rfa')" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PluginOutDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Message Text="Copied opening-tools plugin to $(PluginOutDir)" Importance="high" />
  </Target>
</Project>
