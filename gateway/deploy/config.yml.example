# Ingress for a locally-managed loadingai-gateway tunnel.
#
#   sudo install -m 644 deploy/config.yml.example /etc/cloudflared/config.yml
#   sudo nano /etc/cloudflared/config.yml     # fill in the tunnel id and credentials path
#
# The CredentialsFile is the JSON that `cloudflared tunnel create loadingai-gateway` writes to
# ~/.cloudflared/. The tunnel id is its file name. Route the hostname once with:
#
#   cloudflared tunnel route dns loadingai-gateway gateway.example.com
#
# The service is loopback, so the gateway is never published on a public interface.

tunnel: <tunnel-id>
credentials-file: /etc/cloudflared/<tunnel-id>.json

ingress:
  - hostname: gateway.example.com
    service: http://127.0.0.1:8787
    originRequest:
      connectTimeout: 10
  # Everything else is dropped at the edge.
  - service: http_status:404
