# LoadingAI gateway configuration.
#
# Install as /etc/loadingai-gateway.env, owned by root, mode 600, then restart
# the unit:
#
#   sudo install -m 600 -o root -g root env.example /etc/loadingai-gateway.env
#   sudo nano /etc/loadingai-gateway.env     # paste the two secrets
#   sudo systemctl restart loadingai-gateway
#
# Never commit this file with real values, and never paste the secrets into a
# ticket, a chat, or a Cloudflare variable. Only this VM holds them.

# --- secrets -----------------------------------------------------------------

# Upstream MiniMax key. Rotate it if it has ever been stored anywhere else.
MINIMAX_API_KEY=

# Signs send tickets; independent of the upstream key on purpose, so rotating
# one never invalidates the other. Generate with:
#   openssl rand -hex 32
TICKET_SECRET=

# --- upstream ----------------------------------------------------------------

# Base URL including the API version segment.
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Forced on every proxied call, so a client cannot pick a costlier model.
MINIMAX_MODEL=MiniMax-M3

# --- quota -------------------------------------------------------------------

# Chat sends per device per UTC day.
DAILY_LIMIT=100

# How long one send's ticket stays valid, in seconds. It has to outlive the
# longest tool-calling round.
TICKET_TTL_SECONDS=1800

# --- host --------------------------------------------------------------------

# Loopback only: cloudflared reaches the gateway over the tunnel, so nothing
# needs to be published on the public interface.
HOST=127.0.0.1
PORT=8787

# Counter database. One row per device per UTC day.
QUOTA_DB=/var/lib/loadingai-gateway/quota.db
